        "requiresHumanJudgement": false,
        "qualityRubricRef": null
      }
    },
    {
      "id": "user-cancel",
      "category": "cancel",
      "fixtureRef": "fixtures/example-image-agent/v1/cancel-input.json",
      "expected": {
        "terminalPublicStatus": "cancelled",
        "publicErrorCode": null,
        "requiredEventTypes": ["agent.run.cancelled"],
        "artifactAssertions": [],
        "providerInteraction": "mock-only"
