  "scoring": {
    "minimumPassingScore": 85,
    "metrics": [
      { "key": "contract-correctness", "weight": 0.4, "threshold": 100, "direction": "higher-is-better" },
      { "key": "quality-rubric", "weight": 0.4, "threshold": 85, "direction": "higher-is-better" },
      { "key": "latency", "weight": 0.2, "threshold": 30000, "direction": "lower-is-better" }
    ]
