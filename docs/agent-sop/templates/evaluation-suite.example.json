    },
    {
      "id": "restart-from-checkpoint",
      "category": "recovery",
      "fixtureRef": "fixtures/example-image-agent/v1/recovery-input.json",
      "expected": {
        "terminalPublicStatus": "succeeded",
        "publicErrorCode": null,
        "requiredEventTypes": ["agent.run.progress", "agent.run.succeeded"],
        "artifactAssertions": ["one final artifact record"],
        "providerInteraction": "mock-only"
