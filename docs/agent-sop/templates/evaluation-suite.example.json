{
  "schemaVersion": "0.2",
  "agentKey": "example-image-agent",
  "agentVersion": "0.1.0",
  "suiteVersion": "1.0.0",
  "fixturePolicy": {
    "versioned": true,
    "noProductionPersonalData": true,
    "storageReference": "fixtures/example-image-agent/v1"
  },
  "cases": [
    {
      "id": "authorized-success",
      "category": "success",
      "fixtureRef": "fixtures/example-image-agent/v1/authorized-input.json",
      "expected": {
        "terminalPublicStatus": "succeeded",
        "publicErrorCode": null,
        "requiredEventTypes": ["agent.run.accepted", "agent.run.progress", "agent.run.succeeded"],
        "artifactAssertions": ["private ownership", "sha256 digest", "native viewer supported"],
        "providerInteraction": "mock-only"
      },
      "limits": { "maxLatencyMs": 30000, "maxCostFen": 0, "maxProviderCalls": 1 },
      "review": {
        "automatedAssertions": ["output schema valid", "artifact is private"],
        "requiresHumanJudgement": true,
        "qualityRubricRef": "rubrics/example-image-v1.md"
      }
    },
    {
      "id": "quality-threshold",
      "category": "quality",
      "fixtureRef": "fixtures/example-image-agent/v1/quality-input.json",
      "expected": {
        "terminalPublicStatus": "succeeded",
        "publicErrorCode": null,
        "requiredEventTypes": ["agent.run.succeeded"],
        "artifactAssertions": ["quality rubric score is recorded"],
        "providerInteraction": "mock-only"
      },
      "limits": { "maxLatencyMs": 30000, "maxCostFen": 0, "maxProviderCalls": 1 },
      "review": {
        "automatedAssertions": ["quality score is present"],
        "requiresHumanJudgement": true,
        "qualityRubricRef": "rubrics/example-image-v1.md"
      }
    },
    {
      "id": "invalid-input",
      "category": "failure",
      "fixtureRef": "fixtures/example-image-agent/v1/invalid-input.json",
      "expected": {
        "terminalPublicStatus": "failed",
        "publicErrorCode": "invalid-input",
        "requiredEventTypes": ["agent.run.failed"],
        "artifactAssertions": [],
        "providerInteraction": "none"
      },
      "limits": { "maxLatencyMs": 1000, "maxCostFen": 0, "maxProviderCalls": 0 },
      "review": {
        "automatedAssertions": ["public error is stable", "provider not called"],
        "requiresHumanJudgement": false,
        "qualityRubricRef": null
      }
    },
    {
      "id": "timeout-mapping",
      "category": "timeout",
      "fixtureRef": "fixtures/example-image-agent/v1/timeout-input.json",
      "expected": {
        "terminalPublicStatus": "failed",
