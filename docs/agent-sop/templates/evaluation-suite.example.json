      "limits": { "maxLatencyMs": 5000, "maxCostFen": 0, "maxProviderCalls": 1 },
      "review": {
        "automatedAssertions": ["new work is stopped", "cancel is idempotent"],
        "requiresHumanJudgement": false,
        "qualityRubricRef": null
      }
    },
    {
      "id": "duplicate-request",
      "category": "idempotency",
      "fixtureRef": "fixtures/example-image-agent/v1/idempotent-input.json",
      "expected": {
        "terminalPublicStatus": "succeeded",
        "publicErrorCode": null,
        "requiredEventTypes": ["agent.run.succeeded"],
        "artifactAssertions": ["exactly one artifact record"],
