{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miaoxun.local/schemas/evaluation-suite-v0.2.json",
  "title": "Miaoxun Agent Evaluation Suite v0.2",
  "description": "A versioned, non-production evaluation contract. Fixtures are references only; the suite must never embed personal data, secret material, or raw production payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "agentKey",
    "agentVersion",
    "suiteVersion",
    "fixturePolicy",
    "cases",
    "scoring"
  ],
  "properties": {
    "schemaVersion": { "const": "0.2" },
    "agentKey": { "$ref": "#/$defs/slug" },
    "agentVersion": { "$ref": "#/$defs/semver" },
    "suiteVersion": { "$ref": "#/$defs/semver" },
    "fixturePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["versioned", "noProductionPersonalData", "storageReference"],
      "properties": {
        "versioned": { "const": true },
        "noProductionPersonalData": { "const": true },
        "storageReference": { "type": "string", "minLength": 1, "maxLength": 240 },
        "evidenceScope": { "enum": ["synthetic-contract-only", "empirical-evaluation"] },
        "empiricalQualityEvidence": { "type": "boolean" }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evaluationCase" }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumPassingScore", "metrics"],
      "properties": {
        "minimumPassingScore": { "type": "integer", "minimum": 0, "maximum": 100 },
        "scope": { "enum": ["synthetic-contract-only", "empirical-evaluation"] },
        "empiricalQualityEvidence": { "type": "boolean" },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "weight", "threshold", "direction"],
            "properties": {
              "key": { "$ref": "#/$defs/slug" },
              "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
              "threshold": { "type": "number", "minimum": 0 },
              "direction": { "enum": ["higher-is-better", "lower-is-better"] }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 80 },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "evaluationCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "fixtureRef", "expected", "limits", "review"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "category": {
          "enum": [
            "success",
            "contract",
            "quality",
            "failure",
            "boundary",
            "timeout",
            "cancel",
            "idempotency",
            "authorization",
            "recovery",
            "compatibility",
            "safety",
            "cost"
          ]
        },
        "fixtureRef": { "type": "string", "minLength": 1, "maxLength": 240 },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "terminalPublicStatus",
            "publicErrorCode",
            "requiredEventTypes",
            "artifactAssertions",
            "providerInteraction"
          ],
          "properties": {
            "terminalPublicStatus": {
              "enum": ["succeeded", "failed", "cancelled", "awaiting-user", "awaiting-confirmation"]
            },
            "publicErrorCode": { "type": ["string", "null"], "maxLength": 100 },
            "requiredEventTypes": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 120 }
            },
            "artifactAssertions": {
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 240 }
            },
            "providerInteraction": { "enum": ["none", "mock-only", "approved-calibration-only"] }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxLatencyMs", "maxCostFen", "maxProviderCalls"],
          "properties": {
            "maxLatencyMs": { "type": "integer", "minimum": 1 },
            "maxCostFen": { "type": "integer", "minimum": 0 },
            "maxProviderCalls": { "type": "integer", "minimum": 0 }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["automatedAssertions", "requiresHumanJudgement", "qualityRubricRef"],
          "properties": {
            "automatedAssertions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 240 } },
            "requiresHumanJudgement": { "type": "boolean" },
            "qualityRubricRef": { "type": ["string", "null"], "maxLength": 240 }
          }
        }
      }
    }
  }
}
