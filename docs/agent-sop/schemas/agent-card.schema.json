{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miaoxun.local/schemas/agent-card-v0.2.json",
  "title": "Miaoxun Agent Card v0.2",
  "description": "The client-safe projection produced by the Miaoxun control plane. It intentionally has no provider, secret, internal endpoint, environment, or raw error fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "agentKey",
    "agentVersion",
    "displayName",
    "shortDescription",
    "capabilities",
    "entrypoints",
    "whenToUse",
    "whenNotToUse",
    "limitations",
    "interaction",
    "artifactSupport",
    "minimumAppBuild",
    "availability",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "0.2" },
    "agentKey": { "$ref": "#/$defs/slug" },
    "agentVersion": { "$ref": "#/$defs/semver" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "shortDescription": { "type": "string", "minLength": 1, "maxLength": 180 },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/publicCapability" }
    },
    "entrypoints": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["chat", "workspace", "action", "event", "admin"] }
    },
    "whenToUse": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 180 }
    },
    "whenNotToUse": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 180 }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "type": "string", "minLength": 1, "maxLength": 240 }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runMode", "progress", "requiresConfirmation", "cancellable", "resumable"],
      "properties": {
        "runMode": { "enum": ["synchronous", "asynchronous", "event-driven", "orchestrated"] },
        "progress": { "enum": ["none", "stage", "percentage"] },
        "requiresConfirmation": { "type": "boolean" },
        "cancellable": { "type": "boolean" },
        "resumable": { "type": "boolean" }
      }
    },
    "artifactSupport": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "viewer", "contentTypes"],
        "properties": {
          "type": { "$ref": "#/$defs/slug" },
          "viewer": { "type": ["string", "null"], "maxLength": 80 },
          "contentTypes": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1, "maxLength": 120 }
          }
        }
      }
    },
    "minimumAppBuild": { "type": ["integer", "null"], "minimum": 1 },
    "availability": { "$ref": "#/$defs/clientAvailability" },
    "updatedAt": { "$ref": "#/$defs/utcTimestamp" }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 80 },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "utcTimestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "publicCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "description", "inputSummary", "outputSummary"],
      "properties": {
        "key": { "$ref": "#/$defs/slug" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "minLength": 1, "maxLength": 240 },
        "inputSummary": { "type": "string", "minLength": 1, "maxLength": 180 },
        "outputSummary": { "type": "string", "minLength": 1, "maxLength": 180 }
      }
    },
    "clientAvailability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "canStartRun", "reasonCodes"],
      "properties": {
        "state": {
          "enum": [
            "available",
            "temporarily-unavailable",
            "maintenance",
            "requires-update",
            "not-authorized"
          ]
        },
        "canStartRun": { "type": "boolean" },
        "reasonCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "lifecycle-not-available",
              "operator-disabled",
              "not-ready",
              "capacity-limited",
              "app-version-too-old",
              "not-authorized"
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "availability": {
            "type": "object",
            "properties": { "canStartRun": { "const": true } },
            "required": ["canStartRun"]
          }
        }
      },
      "then": {
        "properties": {
          "availability": {
            "type": "object",
            "properties": {
              "state": { "const": "available" },
              "reasonCodes": { "type": "array", "maxItems": 0 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "availability": {
            "type": "object",
            "properties": { "state": { "const": "available" } },
            "required": ["state"]
          }
        }
      },
      "then": {
        "properties": {
          "availability": {
            "type": "object",
            "properties": {
              "canStartRun": { "const": true },
              "reasonCodes": { "type": "array", "maxItems": 0 }
            }
          }
        }
      }
    }
  ]
}
