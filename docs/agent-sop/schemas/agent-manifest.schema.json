{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miaoxun.local/schemas/agent-manifest-v0.2.json",
  "title": "Miaoxun Internal Agent Manifest v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "key",
    "name",
    "version",
    "owner",
    "lifecycle",
    "profiles",
    "description",
    "limitations",
    "entrypoints",
    "catalog",
    "execution",
    "capabilities",
    "permissions",
    "contracts",
    "artifacts",
    "risk",
    "billing",
    "dependencies",
    "audit",
    "evaluation",
    "compatibility",
    "operations"
  ],
  "properties": {
    "schemaVersion": { "const": "0.2" },
    "key": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 64 },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["team", "agentOwner", "capabilityOwner", "releaseOwner"],
      "properties": {
        "team": { "type": "string", "minLength": 1 },
        "agentOwner": { "type": "string", "minLength": 1 },
        "capabilityOwner": { "type": "string", "minLength": 1 },
        "clientOwner": { "type": ["string", "null"] },
        "securityReviewer": { "type": ["string", "null"] },
        "releaseOwner": { "type": "string", "minLength": 1 }
      }
    },
    "lifecycle": {
      "enum": ["draft", "review", "sandbox", "limited_release", "available", "suspended", "deprecated", "removed"]
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "conversational",
          "synchronous-tool",
          "asynchronous-generation",
          "orchestrator",
          "event-driven",
          "external-provider",
          "artifact-producing",
          "paid",
          "sensitive-data",
          "high-risk-action"
        ]
      }
    },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "entrypoints": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["chat", "workspace", "action", "event", "admin"] }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shortDescription", "capabilities", "whenToUse", "whenNotToUse", "interaction"],
      "properties": {
        "shortDescription": { "type": "string", "minLength": 1, "maxLength": 180 },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/publicCapability" }
        },
        "whenToUse": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 180 }
        },
        "whenNotToUse": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 180 }
        },
        "interaction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["progress", "requiresConfirmation", "artifactAccess"],
          "properties": {
            "progress": { "enum": ["none", "stage", "percentage"] },
            "requiresConfirmation": { "type": "boolean" },
            "artifactAccess": { "type": "boolean" }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "idempotencyRequired", "timeoutSeconds", "cancellable", "resumable", "checkpoint"],
      "properties": {
        "mode": { "enum": ["synchronous", "asynchronous", "event-driven", "orchestrated"] },
        "idempotencyRequired": { "type": "boolean" },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "cancellable": { "type": "boolean" },
        "resumable": { "type": "boolean" },
        "maxConcurrentRunsPerUser": { "type": "integer", "minimum": 1, "maximum": 100 },
        "checkpoint": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/checkpoint" }
          ]
        },
        "deduplicationWindowSeconds": { "type": ["integer", "null"], "minimum": 1, "maximum": 604800 },
        "maxDelegationDepth": { "type": ["integer", "null"], "minimum": 1, "maximum": 10 }
      }
    },
    "capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/slug" } },
    "permissions": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/scope" } },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controlPlaneVersion", "inputSchema", "outputSchema", "publicErrorSchema", "eventSchema"],
      "properties": {
        "controlPlaneVersion": { "type": "string", "minLength": 1 },
        "inputSchema": { "type": "string", "minLength": 1 },
        "outputSchema": { "type": "string", "minLength": 1 },
        "publicErrorSchema": { "type": "string", "minLength": 1 },
        "eventSchema": { "type": "string", "minLength": 1 },
        "domainApiPrefix": { "type": ["string", "null"], "pattern": "^/api/" }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "contentTypes", "defaultVisibility", "retentionDays", "deletable", "integrityRequired"],
        "properties": {
          "type": { "$ref": "#/$defs/slug" },
          "contentTypes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "defaultVisibility": { "enum": ["private", "unlisted", "public"] },
          "retentionDays": { "type": ["integer", "null"], "minimum": 1 },
          "deletable": { "type": "boolean" },
          "integrityRequired": { "const": true },
          "viewer": { "type": ["string", "null"] },
          "minimumAppBuild": { "type": ["integer", "null"], "minimum": 1 }
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "dataClasses", "requiresUserConfirmation", "requiresHumanReview"],
      "properties": {
        "level": { "enum": ["R0", "R1", "R2", "R3"] },
        "dataClasses": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["public", "internal", "private", "sensitive", "credential"] }
        },
        "requiresUserConfirmation": { "type": "boolean" },
        "requiresHumanReview": { "type": "boolean" },
        "consentVersion": { "type": ["string", "null"] }
      }
    },
    "billing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "providerCallsDefaultEnabled", "confirmationRequired", "retryOnUnknownBilling", "userDailyLimit"],
      "properties": {
        "mode": { "enum": ["free", "fixed", "metered"] },
        "currency": { "enum": ["CNY"] },
        "providerCallsDefaultEnabled": { "const": false },
        "confirmationRequired": { "type": "boolean" },
        "userDailyLimit": { "type": ["integer", "null"], "minimum": 1 },
        "globalDailyBudgetFen": { "type": ["integer", "null"], "minimum": 1 },
        "alertThresholdPercent": { "type": ["integer", "null"], "minimum": 1, "maximum": 100 },
        "retryOnUnknownBilling": { "const": false }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providers", "runtimeCapabilities", "requiredEnvironmentNames"],
      "properties": {
        "providers": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/slug" } },
        "runtimeCapabilities": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/slug" } },
        "requiredEnvironmentNames": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventTypes", "redactedFields", "retentionDays", "tracePropagation"],
      "properties": {
        "eventTypes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "redactedFields": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "retentionDays": { "type": "integer", "minimum": 1 },
        "tracePropagation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "format"],
          "properties": {
            "required": { "const": true },
            "format": { "enum": ["w3c-trace-context"] }
          }
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suitePath", "suiteVersion", "minimumPassingScore", "minimumCaseCount", "requiresHumanJudgement"],
      "properties": {
        "suitePath": { "type": "string", "pattern": "^[A-Za-z0-9_./-]+$", "minLength": 1, "maxLength": 240 },
        "suiteVersion": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "minimumPassingScore": { "type": "integer", "minimum": 0, "maximum": 100 },
        "minimumCaseCount": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "requiresHumanJudgement": { "type": "boolean" }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumAppBuild", "minimumBackendContract", "minimumAgentCardSchema"],
      "properties": {
        "minimumAppBuild": { "type": ["integer", "null"], "minimum": 1 },
        "minimumBackendContract": { "type": "string", "minLength": 1 },
        "minimumAgentCardSchema": { "type": "string", "minLength": 1 },
        "replacesAgentVersion": { "type": ["string", "null"] }
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runbook", "providerKillSwitch", "newRunKillSwitch", "deprecationPolicy", "adminControls"],
      "properties": {
        "runbook": { "type": "string", "minLength": 1 },
        "providerKillSwitch": { "type": "string", "minLength": 1 },
        "newRunKillSwitch": { "type": "string", "minLength": 1 },
        "deprecationPolicy": { "type": "string", "minLength": 1 },
        "adminControls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["availability", "recentRuns", "metrics", "cost", "evaluation", "killSwitches"],
          "properties": {
            "availability": { "const": true },
            "recentRuns": { "const": true },
            "metrics": { "const": true },
            "cost": { "const": true },
            "evaluation": { "const": true },
            "killSwitches": { "const": true }
          }
        }
      }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 80 },
    "scope": { "type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$", "maxLength": 100 },
    "publicCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "description", "inputSummary", "outputSummary"],
      "properties": {
        "key": { "$ref": "#/$defs/slug" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "minLength": 1, "maxLength": 240 },
        "inputSummary": { "type": "string", "minLength": 1, "maxLength": 180 },
        "outputSummary": { "type": "string", "minLength": 1, "maxLength": 180 }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "stateSchema", "maxAgeSeconds", "recoveryPolicy", "compatibilityPolicy"],
      "properties": {
        "schemaVersion": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "stateSchema": { "type": "string", "minLength": 1, "maxLength": 240 },
        "maxAgeSeconds": { "type": "integer", "minimum": 60, "maximum": 2592000 },
        "recoveryPolicy": { "enum": ["resume-same-version-only", "restart-from-safe-boundary", "manual-recovery"] },
        "compatibilityPolicy": { "enum": ["same-major-only", "explicit-migration-only"] }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "profiles": { "type": "array", "contains": { "const": "paid" } } }, "required": ["profiles"] },
      "then": {
        "properties": {
          "risk": {
            "type": "object",
            "properties": { "level": { "enum": ["R2", "R3"] } }
          },
          "billing": {
            "type": "object",
            "properties": {
              "mode": { "enum": ["fixed", "metered"] },
              "confirmationRequired": { "const": true },
              "globalDailyBudgetFen": { "type": "integer", "minimum": 1 },
              "alertThresholdPercent": { "type": "integer", "minimum": 1, "maximum": 100 }
            },
            "required": ["globalDailyBudgetFen", "alertThresholdPercent"]
          }
        }
      }
    },
    {
      "if": { "properties": { "profiles": { "type": "array", "contains": { "const": "external-provider" } } }, "required": ["profiles"] },
      "then": {
        "properties": {
          "dependencies": {
            "type": "object",
            "properties": { "providers": { "type": "array", "minItems": 1 } }
          }
        }
      }
    },
    {
      "if": { "properties": { "profiles": { "type": "array", "contains": { "const": "artifact-producing" } } }, "required": ["profiles"] },
      "then": {
        "properties": { "artifacts": { "type": "array", "minItems": 1 } }
      }
    },
    {
      "if": { "properties": { "profiles": { "type": "array", "contains": { "const": "sensitive-data" } } }, "required": ["profiles"] },
      "then": {
        "properties": {
          "risk": {
            "type": "object",
            "properties": {
              "level": { "enum": ["R2", "R3"] },
              "consentVersion": { "type": "string", "minLength": 1 }
            },
            "required": ["consentVersion"]
          }
        }
      }
    },
    {
      "if": { "properties": { "profiles": { "type": "array", "contains": { "const": "high-risk-action" } } }, "required": ["profiles"] },
      "then": {
        "properties": {
          "risk": { "type": "object", "properties": { "level": { "const": "R3" } } }
        }
      }
    },
    {
      "if": {
        "properties": {
          "risk": { "type": "object", "properties": { "level": { "enum": ["R2", "R3"] } }, "required": ["level"] }
        }
      },
      "then": {
        "properties": {
          "risk": {
            "type": "object",
            "properties": { "requiresUserConfirmation": { "const": true } }
          },
          "owner": {
            "type": "object",
            "properties": {
              "securityReviewer": { "type": "string", "minLength": 1 }
            },
            "required": ["securityReviewer"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "risk": { "type": "object", "properties": { "level": { "const": "R3" } }, "required": ["level"] }
        }
      },
      "then": {
        "properties": {
          "risk": {
            "type": "object",
            "properties": { "requiresHumanReview": { "const": true } }
          }
        }
      }
    },
    {
      "if": { "properties": { "profiles": { "type": "array", "contains": { "const": "asynchronous-generation" } } }, "required": ["profiles"] },
      "then": {
        "properties": {
          "execution": {
            "type": "object",
            "required": ["checkpoint"],
            "properties": {
              "mode": { "const": "asynchronous" },
              "resumable": { "const": true },
              "checkpoint": { "$ref": "#/$defs/checkpoint" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "profiles": { "type": "array", "contains": { "const": "event-driven" } } }, "required": ["profiles"] },
      "then": {
        "properties": {
          "execution": {
            "type": "object",
            "required": ["checkpoint", "deduplicationWindowSeconds"],
            "properties": {
              "mode": { "const": "event-driven" },
              "idempotencyRequired": { "const": true },
              "checkpoint": { "$ref": "#/$defs/checkpoint" },
              "deduplicationWindowSeconds": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "profiles": { "type": "array", "contains": { "const": "orchestrator" } } }, "required": ["profiles"] },
      "then": {
        "properties": {
          "execution": {
            "type": "object",
            "required": ["maxDelegationDepth"],
            "properties": {
              "mode": { "const": "orchestrated" },
              "maxDelegationDepth": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  ]
}
