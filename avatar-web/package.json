{
  "name": "@miaoxun/avatar-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private Web workspace for Miaoxun 3D personal avatar generation.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
