# Install as /etc/marvels-chat/database-backup.env with owner root:root and mode 0600.
# Use a dedicated private Bucket and a RAM identity limited to PutObject/GetObject
# under this prefix. Do not reuse the application OSS credentials.
MIAOXUN_DATABASE_BACKUP_OSS_BUCKET=
MIAOXUN_DATABASE_BACKUP_OSS_ENDPOINT=oss-cn-shanghai-internal.aliyuncs.com
MIAOXUN_DATABASE_BACKUP_OSS_PREFIX=postgresql/v1
MIAOXUN_DATABASE_BACKUP_OSS_ACCESS_KEY_ID=
MIAOXUN_DATABASE_BACKUP_OSS_ACCESS_KEY_SECRET=
MIAOXUN_DATABASE_BACKUP_OSS_TIMEOUT_MS=120000

# Keep the database connection local. Use a dedicated read-only PostgreSQL role;
# do not reuse the application role.
MIAOXUN_DATABASE_BACKUP_POSTGRES_HOST=127.0.0.1
MIAOXUN_DATABASE_BACKUP_POSTGRES_PORT=5432
MIAOXUN_DATABASE_BACKUP_POSTGRES_USER=marvels_chat_backup
MIAOXUN_DATABASE_BACKUP_POSTGRES_PASSWORD=
MIAOXUN_DATABASE_BACKUP_POSTGRES_DATABASE=marvels_chat
MIAOXUN_DATABASE_BACKUP_DIR=/opt/projects/marvels-chat/database/backups
MIAOXUN_DATABASE_BACKUP_RETENTION_DAYS=30

# This certificate contains only the offline recovery public key. The matching
# encrypted private key must never be copied to the ECS or committed to Git.
MIAOXUN_DATABASE_BACKUP_RECIPIENT_CERT=/etc/marvels-chat/database-backup-recipient.pem
