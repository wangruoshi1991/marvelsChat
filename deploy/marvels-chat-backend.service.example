[Unit]
Description=Miaoxun backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=marvels
WorkingDirectory=/opt/projects/marvels-chat/app/backend
EnvironmentFile=/opt/projects/marvels-chat/app/deploy/miaoxun-prod.env
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5s
TimeoutStopSec=90s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
