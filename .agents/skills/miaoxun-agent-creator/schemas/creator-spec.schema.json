{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:miaoxun:creator:creator-spec:0.1.0",
  "title": "Miaoxun Creator Spec 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "agent", "creator", "interaction", "dataUse", "cost", "implementation", "integration", "verification"],
  "properties": {
    "$schema": { "const": "./contracts/creator-spec.schema.json" },
    "schemaVersion": { "const": "0.1.0" },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "version", "description", "goal", "nonGoals", "profiles", "status"],
      "properties": {
        "key": { "$ref": "#/$defs/slug" },
        "name": { "$ref": "#/$defs/shortText" },
        "version": { "$ref": "#/$defs/semver" },
        "description": { "type": "string", "minLength": 1, "maxLength": 240 },
        "goal": { "type": "string", "minLength": 1, "maxLength": 500 },
        "nonGoals": { "type": "array", "maxItems": 30, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "enum": ["conversational", "synchronous-tool", "asynchronous-generation", "orchestrator", "event-driven", "external-provider", "artifact-producing", "paid", "sensitive-data", "high-risk-action"]
          }
        },
        "status": { "const": "draft" }
      }
    },
    "creator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName", "team"],
      "properties": {
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "team": { "type": ["string", "null"], "minLength": 1, "maxLength": 120 }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runMode", "progress", "confirmBeforeActions"],
      "properties": {
        "runMode": { "enum": ["synchronous", "asynchronous", "event-driven", "orchestrated"] },
        "progress": { "enum": ["none", "stage", "percentage"] },
        "confirmBeforeActions": { "type": "array", "maxItems": 30, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
      }
    },
    "dataUse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputClasses", "externalRecipients", "retentionDays", "deletionSupported", "consentRequired"],
      "properties": {
        "inputClasses": { "type": "array", "minItems": 1, "maxItems": 30, "uniqueItems": true, "items": { "$ref": "#/$defs/slug" } },
        "externalRecipients": { "type": "array", "maxItems": 30, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
        "retentionDays": { "type": ["integer", "null"], "minimum": 1, "maximum": 3650 },
        "deletionSupported": { "type": "boolean" },
        "consentRequired": { "type": "boolean" }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "payer", "budgetCny", "realProviderCallsApproved", "retryOnUnknownBilling"],
      "properties": {
        "mode": { "enum": ["free", "fixed", "metered"] },
        "payer": { "enum": ["creator", "user", "platform", "not-applicable"] },
        "budgetCny": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "realProviderCallsApproved": { "const": false },
        "retryOnUnknownBilling": { "const": false }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "entry", "testCommand"],
      "properties": {
        "kind": { "enum": ["instructions", "source", "external-service"] },
        "entry": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[A-Za-z0-9_./-]+$" },
        "testCommand": { "type": ["string", "null"], "minLength": 1, "maxLength": 500 }
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "requestedCapabilities", "requestedArtifactTypes", "minimumClientBuild"],
      "properties": {
        "status": { "enum": ["not-submitted", "submitted"] },
        "requestedCapabilities": { "type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": { "$ref": "#/$defs/slug" } },
        "requestedArtifactTypes": { "type": "array", "maxItems": 30, "uniqueItems": true, "items": { "$ref": "#/$defs/slug" } },
        "minimumClientBuild": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "status", "evidence"],
      "properties": {
        "environment": { "enum": ["not-run", "local-mock", "local-real"] },
        "status": { "enum": ["not-run", "local-checked"] },
        "evidence": { "type": "array", "maxItems": 50, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "agent": {
            "type": "object",
            "properties": {
              "profiles": { "type": "array", "contains": { "const": "paid" } }
            },
            "required": ["profiles"]
          }
        },
        "required": ["agent"]
      },
      "then": {
        "properties": {
          "cost": {
            "type": "object",
            "properties": {
              "mode": { "enum": ["fixed", "metered"] },
              "payer": { "enum": ["creator", "user", "platform"] },
              "budgetCny": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["mode", "payer", "budgetCny"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent": {
            "type": "object",
            "properties": {
              "profiles": { "type": "array", "contains": { "const": "sensitive-data" } }
            },
            "required": ["profiles"]
          }
        },
        "required": ["agent"]
      },
      "then": {
        "properties": {
          "dataUse": {
            "type": "object",
            "properties": {
              "deletionSupported": { "const": true },
              "consentRequired": { "const": true }
            },
            "required": ["deletionSupported", "consentRequired"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent": {
            "type": "object",
            "properties": {
              "profiles": { "type": "array", "contains": { "const": "high-risk-action" } }
            },
            "required": ["profiles"]
          }
        },
        "required": ["agent"]
      },
      "then": {
        "properties": {
          "interaction": {
            "type": "object",
            "properties": {
              "confirmBeforeActions": { "type": "array", "minItems": 1 }
            },
            "required": ["confirmBeforeActions"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent": {
            "type": "object",
            "properties": {
              "profiles": { "type": "array", "contains": { "const": "event-driven" } }
            },
            "required": ["profiles"]
          }
        },
        "required": ["agent"]
      },
      "then": {
        "properties": {
          "interaction": {
            "type": "object",
            "properties": { "runMode": { "const": "event-driven" } },
            "required": ["runMode"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent": {
            "type": "object",
            "properties": {
              "profiles": {
                "type": "array",
                "contains": { "const": "asynchronous-generation" },
                "not": { "type": "array", "contains": { "const": "event-driven" } }
              }
            },
            "required": ["profiles"]
          }
        },
        "required": ["agent"]
      },
      "then": {
        "properties": {
          "interaction": {
            "type": "object",
            "properties": { "runMode": { "const": "asynchronous" } },
            "required": ["runMode"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent": {
            "type": "object",
            "properties": {
              "profiles": {
                "type": "array",
                "contains": { "const": "orchestrator" },
                "allOf": [
                  { "not": { "type": "array", "contains": { "const": "event-driven" } } },
                  { "not": { "type": "array", "contains": { "const": "asynchronous-generation" } } }
                ]
              }
            },
            "required": ["profiles"]
          }
        },
        "required": ["agent"]
      },
      "then": {
        "properties": {
          "interaction": {
            "type": "object",
            "properties": { "runMode": { "const": "orchestrated" } },
            "required": ["runMode"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent": {
            "type": "object",
            "properties": {
              "profiles": {
                "type": "array",
                "allOf": [
                  { "not": { "type": "array", "contains": { "const": "event-driven" } } },
                  { "not": { "type": "array", "contains": { "const": "asynchronous-generation" } } },
                  { "not": { "type": "array", "contains": { "const": "orchestrator" } } }
                ]
              }
            },
            "required": ["profiles"]
          }
        },
        "required": ["agent"]
      },
      "then": {
        "properties": {
          "interaction": {
            "type": "object",
            "properties": { "runMode": { "const": "synchronous" } },
            "required": ["runMode"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification": {
            "type": "object",
            "properties": { "status": { "const": "local-checked" } },
            "required": ["status"]
          }
        },
        "required": ["verification"]
      },
      "then": {
        "properties": {
          "verification": {
            "type": "object",
            "properties": {
              "environment": { "enum": ["local-mock", "local-real"] },
              "evidence": { "type": "array", "minItems": 1 }
            },
            "required": ["environment", "evidence"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification": {
            "type": "object",
            "properties": { "status": { "const": "not-run" } },
            "required": ["status"]
          }
        },
        "required": ["verification"]
      },
      "then": {
        "properties": {
          "verification": {
            "type": "object",
            "properties": {
              "environment": { "const": "not-run" },
              "evidence": { "type": "array", "maxItems": 0 }
            },
            "required": ["environment", "evidence"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "implementation": {
            "type": "object",
            "properties": { "kind": { "const": "instructions" } },
            "required": ["kind"]
          }
        },
        "required": ["implementation"]
      },
      "then": {
        "properties": {
          "implementation": {
            "type": "object",
            "properties": { "entry": { "const": "instructions.md" } },
            "required": ["entry"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "implementation": {
            "type": "object",
            "properties": { "kind": { "const": "source" } },
            "required": ["kind"]
          }
        },
        "required": ["implementation"]
      },
      "then": {
        "properties": {
          "implementation": {
            "type": "object",
            "properties": { "entry": { "type": "string", "pattern": "^src/[A-Za-z0-9_./-]+$" } },
            "required": ["entry"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "implementation": {
            "type": "object",
            "properties": { "kind": { "const": "external-service" } },
            "required": ["kind"]
          }
        },
        "required": ["implementation"]
      },
      "then": {
        "properties": {
          "implementation": {
            "type": "object",
            "properties": { "entry": { "const": "handoff.md" } },
            "required": ["entry"]
          }
        }
      }
    }
  ],
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 80 },
    "shortText": { "type": "string", "minLength": 1, "maxLength": 80 },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" }
  }
}
