{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miaoxun.local/schemas/media-retrieval-search-response.schema.json",
  "title": "Media retrieval search response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agentRunId",
    "lifecycleStatus",
    "method",
    "results"
  ],
  "properties": {
    "agentRunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "lifecycleStatus": {
      "enum": [
        "accepted",
        "queued",
        "running",
        "awaiting_user",
        "purging",
        "succeeded",
        "failed",
        "cancelled",
        "blocked",
        "idle"
      ]
    },
    "method": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "results": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mediaAssetId",
          "kind",
          "matchedFrameTimestampMs",
          "summary",
          "matchReasons",
          "scoreBucket"
        ],
        "properties": {
          "mediaAssetId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "kind": {
            "enum": [
              "image",
              "video"
            ]
          },
          "matchedFrameTimestampMs": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "summary": {
            "type": "string",
            "maxLength": 160
          },
          "matchReasons": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "string",
              "maxLength": 64
            }
          },
          "scoreBucket": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      }
    }
  }
}
