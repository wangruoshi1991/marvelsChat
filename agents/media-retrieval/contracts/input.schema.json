{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Media retrieval public input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation"
  ],
  "properties": {
    "operation": {
      "enum": [
        "enable",
        "status",
        "search",
        "reindex",
        "disable"
      ]
    },
    "consentVersion": {
      "type": "string",
      "maxLength": 100
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "kind": {
      "enum": [
        "image",
        "video"
      ]
    },
    "albumId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "scope": {
      "enum": [
        "stale",
        "all"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "enable"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "required": [
          "consentVersion"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "search"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "required": [
          "query"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "reindex"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "required": [
          "scope"
        ]
      }
    }
  ]
}
