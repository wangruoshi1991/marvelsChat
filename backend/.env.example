NODE_ENV=development
HOST=127.0.0.1
PORT=4390
# 隔离启动器在进程环境设置 MIAOXUN_DOTENV_ENABLED=false，跳过本目录 .env。
# 普通运行默认读取 .env；不要在生产环境复制本地开发启动器配置。
# 本地媒体目录的可选绝对路径，留空使用 backend/storage/station-media。
MIAOXUN_LOCAL_MEDIA_ROOT=
# 后台上传的 Agent 品牌头像，默认 backend/storage/agent-avatars；必须随持久化 storage 一起备份/发布迁移。
MIAOXUN_AGENT_AVATAR_ROOT=
# Build54 仅支持图形头像。图片头像草稿可编辑；配套App验收/分发完成后才允许显式开启图片发布。
AGENT_IMAGE_PUBLICATION_ENABLED=false
TRUST_PROXY_HOPS=0
CORS_ORIGIN=true
DATABASE_URL=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=miaoxun
POSTGRES_PASSWORD=miaoxun_dev
POSTGRES_DATABASE=marvels_chat
POSTGRES_CONNECTION_LIMIT=10
SESSION_TTL_DAYS=30
CREATE_FIRST_USER_AS_ADMIN=true
ADMIN_EMAILS=
DEFAULT_ADMIN_ENABLED=false
DEFAULT_ADMIN_LOGIN=admin
DEFAULT_ADMIN_EMAIL=admin@miaoxun.local
DEFAULT_ADMIN_PASSWORD=change-this-admin-password
DEFAULT_ADMIN_DISPLAY_NAME=妙讯管理员
DEFAULT_ADMIN_RESET_PASSWORD_ON_BOOTSTRAP=false
# 对话 Agent 和媒体检索原文角色解析共用；解析失败不会改用视觉供应商。
# 文本 Agent 配置入口：src/agent-model-config.js；推荐 profile 只有显式填写环境后才生效。
NEW_API_BASE_URL=https://fushengyunsuan.cn/v1
NEW_API_KEY=
NEW_API_MODEL=gpt-6.1-sol
# 可选：分派、协调、结构化生成和工具规划共用同一地址/Key；留空明确继承 NEW_API_MODEL。
# 普通聊天与媒体检索原文解析仍使用 NEW_API_MODEL；失败不会切换模型或供应商。
NEW_API_PLANNING_MODEL=
NEW_API_TIMEOUT_MS=30000
# 持久协作的协调与专业贡献是异步执行；默认单次模型请求上限3分钟，仍受20分钟任务总期限约束。
NEW_API_WORKSPACE_TIMEOUT_MS=180000
# 漫画逐格成图独立配置，默认关闭；已核验 cicadas-openai-images。
# 对应固定基址 https://api.cicadas.top/v1、型号 gpt-image-2、尺寸1024x1024。
# 不继承文本、3D、检索供应商或 OSS 凭据。只在后端/Worker secret 环境填写 Key。
MEDIA_GENERATION_ENABLED=
MEDIA_GENERATION_PROVIDER=
MEDIA_GENERATION_API_BASE_URL=
MEDIA_GENERATION_API_KEY=
MEDIA_GENERATION_IMAGE_MODEL=
# 留空默认90000；整数1..300000毫秒。
MEDIA_GENERATION_TIMEOUT_MS=
# 相册对话/建站持久任务另开进程 npm run worker:ai-tasks，使用相同数据库与以上供应商配置。
# API ready 不证明 Worker 存活；执行状态来自 ai_tasks，未知结果不自动重放。
DASHSCOPE_API_BASE_URL=https://dashscope.aliyuncs.com
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
# Optional: defaults to the Beijing URL derived from DASHSCOPE_WORKSPACE_ID.
DASHSCOPE_WANX_BASE_URL=
DASHSCOPE_TRIPO_MODEL=Tripo/Tripo-H3.1
DASHSCOPE_WAN_MULTIVIEW_MODEL=wan2.7-image-pro
DASHSCOPE_TIMEOUT_MS=60000
AVATAR_3D_ENABLED=false
AVATAR_3D_PROVIDER_CALLS_ENABLED=false
# Use * to enable 3D for all authenticated users once the global switches are on.
AVATAR_3D_ALLOWLIST=
AVATAR_3D_DAILY_LIMIT=3
AVATAR_3D_RETENTION_DAYS=7
AVATAR_3D_REFERENCE_COST_FEN=200
AVATAR_3D_STANDARD_COST_FEN=280
AVATAR_3D_ULTRA_COST_FEN=420
GEOCODING_PROVIDER=nominatim
GEOCODING_REVERSE_URL=
GEOCODING_USER_AGENT=
GEOCODING_EMAIL=
GEOCODING_ACCEPT_LANGUAGE=zh-CN,zh;q=0.9,en;q=0.6
GEOCODING_TIMEOUT_MS=8000
AMAP_WEB_SERVICE_KEY=
AMAP_REVERSE_URL=https://restapi.amap.com/v3/geocode/regeo
OSS_REGION=cn-shanghai
OSS_BUCKET=marvels-chat
OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
OSS_INTERNAL_ENDPOINT=oss-cn-shanghai-internal.aliyuncs.com
OSS_PUBLIC_BASE_URL=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_TIMEOUT_MS=60000

# 当前视觉/图文向量采用 DashScope 原生 /api/v1 合同，不继承 NEW_API 地址或 Key。
# 向量必须是同一图文空间的 1024 维；中转协议未核实前不要仅替换基址。
# 地址/模型版本属于索引来源信息，切换需验证协议并安排受控重建。
MEDIA_RETRIEVAL_ENABLED=
MEDIA_RETRIEVAL_PROVIDER_CALLS_ENABLED=
MEDIA_RETRIEVAL_DASHSCOPE_API_KEY=
MEDIA_RETRIEVAL_DASHSCOPE_API_BASE_URL=
MEDIA_RETRIEVAL_CAPTION_MODEL=
MEDIA_RETRIEVAL_CAPTION_MODEL_VERSION=
MEDIA_RETRIEVAL_EMBEDDING_MODEL=
MEDIA_RETRIEVAL_EMBEDDING_MODEL_VERSION=
MEDIA_RETRIEVAL_EMBEDDING_DIMENSION=
MEDIA_RETRIEVAL_EMBEDDING_NORMALIZATION=
MEDIA_RETRIEVAL_MAX_VIDEO_FRAMES=
# Caption calls: bounded 10–120s, default 90s. No automatic retry after a timeout.
MEDIA_RETRIEVAL_CAPTION_TIMEOUT_MS=90000
MEDIA_RETRIEVAL_WORKER_POLL_MS=
MEDIA_RETRIEVAL_USER_DAILY_REQUEST_LIMIT=
MEDIA_RETRIEVAL_USER_MONTHLY_BUDGET_FEN=
MEDIA_RETRIEVAL_GLOBAL_DAILY_BUDGET_FEN=
MEDIA_RETRIEVAL_CAPTION_RESERVE_FEN=
MEDIA_RETRIEVAL_EMBEDDING_RESERVE_FEN=

# Same API/AI Worker/PostgreSQL: dynamic Agent workspaces (migration 037).
# No fixed step/call/turn limits. Actual usage and provider monetary ledgers remain recorded.
# The Agent runtime shares this execution deadline, including standalone album tasks.
AGENT_WORKSPACE_DEADLINE_SECONDS=1200
# Independent Agent nodes run in parallel up to this bound (1-20).
AGENT_WORKSPACE_MAX_CONCURRENT=4
