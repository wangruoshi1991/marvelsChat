# The local preview launcher generates its runtime.env from a strict allowlist.
# This file documents that profile; do not put credentials here or copy the
# production .env. Start with: node scripts/miaoxun-development.mjs start
NODE_ENV=development
MIAOXUN_DOTENV_ENABLED=false
HOST=127.0.0.1
PORT=4391
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55441
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DATABASE=miaoxun_development
DATABASE_URL=
DEFAULT_ADMIN_ENABLED=false
CREATE_FIRST_USER_AS_ADMIN=false
# Shared text-model routing: src/agent-model-config.js; profiles are opt-in references only.
NEW_API_BASE_URL=https://fushengyunsuan.cn/v1
NEW_API_KEY=
NEW_API_MODEL=gpt-6.1-sol
# Optional planning override for dispatch/coordination/structured generation/tool planning.
# Empty explicitly inherits NEW_API_MODEL; shares NEW_API_BASE_URL and NEW_API_KEY.
NEW_API_PLANNING_MODEL=
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
MEDIA_RETRIEVAL_ENABLED=false
MEDIA_RETRIEVAL_PROVIDER_CALLS_ENABLED=false
AVATAR_3D_ENABLED=false
AVATAR_3D_PROVIDER_CALLS_ENABLED=false
OSS_BUCKET=
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
GEOCODING_REVERSE_URL=
AMAP_WEB_SERVICE_KEY=
# Actual value is the launcher's private state directory followed by /media.
MIAOXUN_LOCAL_MEDIA_ROOT=/absolute/path/to/private/development-state/media

# Same API/AI Worker/PostgreSQL: dynamic Agent workspaces (migration 037).
# Shared execution deadline; no fixed model-call, step or planning-turn quotas.
AGENT_WORKSPACE_DEADLINE_SECONDS=1200
